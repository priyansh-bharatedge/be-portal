# Zoho CRM OAuth & REST API Configuration (.in domain)
VITE_ZOHO_CLIENT_ID=your_zoho_client_id
VITE_ZOHO_CLIENT_SECRET=your_zoho_client_secret
VITE_ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
VITE_ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
VITE_ZOHO_API_URL=https://www.zohoapis.in
VITE_ZOHO_MODULE_NAME=Quotations
VITE_ZOHO_COMPANIES_MODULE_NAME=Companies
VITE_ZOHO_CLIENTS_MODULE_NAME=Clients
VITE_ZOHO_COMPANY_POLICIES_MODULE_NAME=Company_Policies
VITE_ZOHO_CALENDAR_MODULE_NAME=Company_Calendar
VITE_ZOHO_DSR_MODULE_NAME=DSR

# Nodemailer SMTP Configuration for OTP Email Delivery (support@bharat-edge.com)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@bharat-edge.com
SMTP_PASS=your_email_or_app_password
SMTP_FROM="BharatEdge Support" <support@bharat-edge.com>



